# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only — for npm run db:reset-test-data (never commit or expose in the browser)
# SUPABASE_SERVICE_ROLE_KEY=

# Production only: canonical site URL (no trailing slash). Set on Vercel so Google OAuth
# returns to https://your-app.vercel.app/auth/callback instead of localhost.
# Leave unset for local dev (uses http://localhost:3000 automatically).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Web Push reminders — generate with: node scripts/generate-vapid-keys.mjs
# (Set on Vercel too. Rotating these invalidates every existing push subscription.)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLjHzexKfe9YrckOEFRGj6SjjV0HwLaXg_mPz3EtNGRw8IlHp0doLaO0fnBcdfBVG_uikoaHVjaZ8ZTcpgqFzOI
VAPID_PRIVATE_KEY=IwzKYbgB_nSv3w1gnfz4OrETAlOBsJqRgp8xp7mA0tY
VAPID_CONTACT_EMAIL=bhuminpatel705@gmail.com

# Random secret protecting /api/cron/reminders (Vercel passes it as
